# Copy this file to .env and fill in what you have. Never commit .env.

# ---- DetectifAI (leave empty to run in MOCK mode) ----
DETECTIF_API_KEY=
# From the DetectifAI dashboard webhook settings (starts with whsec_). Only needed for VIGIL_LIVE_MODE=direct.
DETECTIF_WEBHOOK_SECRET=
# mock | detectif  (default: detectif when a key is set, otherwise mock)
# VIGIL_PROVIDER=

# ---- Twilio (Mode B: live calls) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your public https URL (e.g. from `ngrok http 8000`). Twilio must reach it.
PUBLIC_BASE_URL=http://127.0.0.1:8000
# relay (recommended): Twilio -> VIGIL -> DetectifAI, results arrive live
# direct: Twilio -> DetectifAI, results via DetectifAI webhooks to /webhooks/detectif
VIGIL_LIVE_MODE=relay
# Phone number a flagged caller is transferred to (optional, E.164 e.g. +9198xxxxxxx)
HUMAN_AGENT_NUMBER=
# Speaker to verify when the caller's number isn't linked to an enrolled speaker (optional)
DEFAULT_LIVE_SPEAKER_ID=
TWILIO_VALIDATE_SIGNATURE=true

# ---- Tuning ----
MIDCALL_VERIFY=true
MIDCALL_VERIFY_SECONDS=10
HOLD_MAX_LOOPS=8

# ---- Dashboard ----
VIGIL_API_URL=http://127.0.0.1:8000
